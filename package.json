{
  "name": "worldloom",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Worldloom: worldbuilding e campagne di gioco come grafo di snippet",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
